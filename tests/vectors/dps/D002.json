{
  "id": "D002",
  "title": "Protected endpoint: 401 without identity, 403 when revoked, 200 with identity (clientEndPoints JSON, ssl)",
  "runner": "dps",
  "source_refs": [
    "taky/taky/dps/__init__.py:12",
    "taky/taky/dps/views/index.py:9"
  ],
  "notes": "",
  "config": {
    "taky": {
      "hostname": "taky.example",
      "node_id": "NODE-1"
    },
    "ssl": {
      "enabled": "true"
    }
  },
  "initial_files": {},
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/Marti/api/clientEndPoints",
        "identity": null
      },
      "expect": {
        "status": 401,
        "content_type": "text/html; charset=utf-8",
        "body_is_framework_page": true
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/Marti/api/clientEndPoints",
        "identity": {
          "cn": "bob",
          "revoked": true
        }
      },
      "expect": {
        "status": 403,
        "content_type": "text/html; charset=utf-8",
        "body_is_framework_page": true
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/Marti/api/clientEndPoints",
        "identity": {
          "cn": "alice"
        }
      },
      "expect": {
        "status": 200,
        "content_type": "application/json",
        "body_json": {
          "BaseUrl": "",
          "Matcher": "com.bbn.marti.remote.ClientEndpoint",
          "NotificationId": "",
          "ServerConnectString": "ssl:taky.example:8089",
          "data": [],
          "type": "com.bbn.marti.remote.ClientEndpoint"
        }
      }
    }
  ],
  "final_expect": {
    "files": {}
  },
  "format": 2,
  "requires": [
    "tls"
  ],
  "verified_against": {
    "oracle": "python taky 0.9 (tools/run_python_dps.py)",
    "versions": [
      "python 3.13.17",
      "Flask 2.3.3",
      "Werkzeug 3.1.9",
      "lxml 6.1.3",
      "cryptography 50.0.2",
      "libxml2 2.14.6"
    ]
  }
}
