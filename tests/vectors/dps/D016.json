  ],
  "notes": "D-1: the Python parser is XMLParser(resolve_entities=True), so a DOCTYPE/entity is accepted (here the internal entity &x; expands to 'F1' and the feed is saved as video_feed/F1.xml); with an external SYSTEM entity this is an XXE file-read primitive. Rust parses with DTD loading and entity resolution disabled and returns 400 'Malformed XML' for any document with a DOCTYPE; nothing is written.",
  "config": {
    "taky": {
      "hostname": "taky.example",
      "node_id": "NODE-1"
    },
    "ssl": {
      "enabled": "true"
    }
  },
  "initial_files": {},
