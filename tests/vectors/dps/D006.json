{
  "id": "D006",
  "title": "Re-upload same name with new hash: old hash link removed, meta overwritten, Visibility reset to private",
  "runner": "dps",
  "source_refs": [
    "taky/taky/dps/views/datapackage.py:128"
  ],
  "notes": "",
  "config": {
    "taky": {
      "hostname": "taky.example",
      "node_id": "NODE-1"
    },
    "ssl": {
      "enabled": "true"
    }
  },
  "initial_files": {
    "U1_pkg.zip": {
      "content": "DATA"
    },
    "meta/U1_pkg.zip.json": {
      "content": "{\"UID\": \"U1_pkg.zip\", \"Name\": \"pkg.zip\", \"Hash\": \"h1\", \"PrimaryKey\": 1, \"SubmissionDateTime\": \"2030-01-01T00:00:00.000000Z\", \"SubmissionUser\": \"alice\", \"CreatorUid\": \"U1\", \"Keywords\": \"kw\", \"MIMEType\": \"application/zip\", \"Size\": 4, \"Visibility\": \"public\"}"
    },
    "meta/h1.json": {
      "symlink_to": "U1_pkg.zip.json"
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/Marti/sync/missionupload",
        "identity": {
          "cn": "alice"
        },
        "query": {
          "hash": "h2",
          "creatorUid": "U1"
        },
        "multipart": [
          {
            "name": "assetfile",
            "filename": "pkg.zip",
            "content_type": "application/zip",
            "data": "NEWDATA"
          }
        ]
      },
      "expect": {
        "status": 200,
        "content_type": "text/html; charset=utf-8",
        "body": "https://taky.example:8443//Marti/sync/content?hash=h2"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/Marti/sync/search",
        "identity": {
          "cn": "alice"
        }
      },
      "expect": {
        "status": 200,
        "content_type": "application/json",
        "body_json": {
          "resultCount": 0,
          "results": []
        }
      }
    }
  ],
  "final_expect": {
    "files": {
      "U1_pkg.zip": {
        "content": "NEWDATA"
      },
      "meta/U1_pkg.zip.json": {
        "content": "{\"UID\": \"U1_pkg.zip\", \"Name\": \"pkg.zip\", \"Hash\": \"h2\", \"PrimaryKey\": 1, \"SubmissionDateTime\": \"$TIMESTAMP\", \"SubmissionUser\": \"alice\", \"CreatorUid\": \"U1\", \"Keywords\": \"kw\", \"MIMEType\": \"application/zip\", \"Size\": 7, \"Visibility\": \"private\"}"
      },
      "meta/h2.json": {
        "symlink_to": "U1_pkg.zip.json"
      }
    }
  },
  "format": 2,
  "requires": [
    "tls"
  ],
  "verified_against": {
    "oracle": "python taky 0.9 (tools/run_python_dps.py)",
    "versions": [
      "python 3.13.17",
      "Flask 2.3.3",
      "Werkzeug 3.1.9",
      "lxml 6.1.3",
      "cryptography 50.0.2",
      "libxml2 2.14.6"
    ]
  }
}
