{
  "id": "U003",
  "title": "taky.conf parsing/normalisation (configparser + load_config)",
  "runner": "unit",
  "kind": "ini",
  "source_refs": [
    "taky/taky/config.py:42"
  ],
  "notes": "load_config(path) not explicit. $CFG_DIR = realpath of the config directory. taky_output: config_error_message = 'Configuration file error: …' (exit 1), traceback = uncaught exception (exit 1), message = Rust readable message (D-13, exit 1).",
  "expected-divergence": [
    "D-13",
    "D-14"
  ],
  "cases": [
    {
      "input": "[taky]\nhostname = a%%b\n",
      "keys": [
        "taky.hostname"
      ],
      "rust_expect": {
        "values": {
          "taky.hostname": "a%b"
        }
      },
      "note": "D-14: %% -> %",
      "expect": {
        "error": "ValueError",
        "taky_exit": 1,
        "taky_output": "traceback"
      }
    },
    {
      "input": "[taky]\nhostname = a%b\n",
      "keys": [
        "taky.hostname"
      ],
      "rust_expect": {
        "error": "InterpolationSyntaxError",
        "taky_exit": 1,
        "taky_output": "config_error_message"
      },
      "note": "D-14/D-13: single % -> Configuration file error, exit 1",
      "expect": {
        "error": "InterpolationSyntaxError",
        "taky_exit": 1,
        "taky_output": "traceback"
      }
    },
    {
      "input": "[ssl]\nserver_p12_pw = pa%ss\n",
      "keys": [
        "ssl.server_p12_pw"
      ],
      "rust_expect": {
        "error": "InterpolationSyntaxError",
        "taky_exit": 1,
        "taky_output": "config_error_message"
      },
      "note": "D-14",
      "expect": {
        "error": "InterpolationSyntaxError",
        "taky_exit": 1,
        "taky_output": "traceback"
      }
    },
    {
      "input": "[taky]\nhostname = srv\nnode_id = %(hostname)s-n\n",
      "keys": [
        "taky.node_id"
      ],
      "expect": {
        "values": {
          "taky.node_id": "srv-n"
        }
      }
    },
    {
      "input": "[taky]\nnode_id = %(hostname)s-n\n",
      "keys": [
        "taky.node_id"
      ],
      "note": "default hostname is visible to interpolation",
      "expect": {
        "values": {
          "taky.node_id": "taky.local-n"
        }
      }
    },
    {
      "input": "[taky]\nnode_id = %(nokey)s\n",
      "keys": [
        "taky.node_id"
      ],
      "rust_expect": {
        "error": "InterpolationMissingOptionError",
        "taky_exit": 1,
        "taky_output": "config_error_message"
      },
      "note": "D-13",
      "expect": {
        "error": "InterpolationMissingOptionError",
        "taky_exit": 1,
        "taky_output": "traceback"
      }
    },
    {
      "input": "[taky]\nbind_ip\nnode_id = %(bind_ip)s\n",
      "keys": [
        "taky.node_id"
      ],
      "rust_expect": {
        "error": "InterpolationMissingOptionError",
        "taky_exit": 1,
        "taky_output": "config_error_message"
      },
      "note": "D-13: %(k)s -> valueless key (Python TypeError traceback)",
      "expect": {
        "error": "TypeError",
        "taky_exit": 1,
        "taky_output": "traceback"
      }
    },
    {
      "input": "[taky]\n# 100% comment\nhostname = h\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "values": {
          "taky.hostname": "h"
        }
      }
    },
    {
      "input": "[taky]\nHostName = X\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "values": {
          "taky.hostname": "X"
        }
      }
    },
    {
      "input": "[TAKY]\nhostname = X\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "values": {
          "taky.hostname": "taky.local"
        }
      }
    },
    {
      "input": "[taky]\nredis\nbind_ip =\n",
      "keys": [
        "taky.redis",
        "taky.bind_ip"
      ],
      "expect": {
        "values": {
          "taky.redis": null,
          "taky.bind_ip": ""
        }
      }
    },
    {
      "input": "[taky]\nhostname = h # inline\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "values": {
          "taky.hostname": "h # inline"
        }
      }
    },
    {
      "input": "[taky]\nhostname = h ; inline\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "values": {
          "taky.hostname": "h ; inline"
        }
      }
    },
    {
      "input": "[taky]\nhostname = \"q\"\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "values": {
          "taky.hostname": "\"q\""
        }
      }
    },
    {
      "input": "[taky]\nhostname: colon\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "values": {
          "taky.hostname": "colon"
        }
      }
    },
    {
      "input": "[taky]\nhostname = a\n  continued\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "values": {
          "taky.hostname": "a\ncontinued"
        }
      }
    },
    {
      "input": "[taky]\n  # indented comment\nhostname = a\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "values": {
          "taky.hostname": "a"
