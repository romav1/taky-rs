      "input": "[cot_server]\nport = 65535\n",
      "keys": [
        "cot_server.port"
      ],
      "rust_expect": {
        "error": "ValueError",
        "taky_exit": 1,
        "taky_output": "message"
      },
      "note": "D-13",
      "expect": {
        "error": "ValueError",
        "taky_exit": 1,
        "taky_output": "traceback"
      }
    },
