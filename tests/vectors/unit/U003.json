      }
    },
    {
      "input": "[DEFAULT]\nhostname = d\n[cot_server]\n",
      "keys": [
        "taky.hostname",
        "cot_server.hostname"
      ],
      "expect": {
        "values": {
          "taky.hostname": "taky.local",
          "cot_server.hostname": "d"
        }
      }
    },
    {
      "input": "[taky]\nhostname = a\nhostname = b\n",
      "keys": [
        "taky.hostname"
      ],
      "rust_expect": {
        "error": "DuplicateOptionError",
        "taky_exit": 1,
        "taky_output": "message"
      },
      "note": "D-13",
      "expect": {
        "error": "DuplicateOptionError",
        "taky_exit": 1,
        "taky_output": "traceback"
      }
    },
    {
      "input": "[taky]\nhostname = a\n[taky]\n",
      "keys": [
        "taky.hostname"
      ],
      "rust_expect": {
        "error": "DuplicateSectionError",
        "taky_exit": 1,
        "taky_output": "message"
      },
      "note": "D-13",
      "expect": {
        "error": "DuplicateSectionError",
        "taky_exit": 1,
        "taky_output": "traceback"
      }
    },
    {
      "input": "hostname = x\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "error": "MissingSectionHeaderError",
        "taky_exit": 1,
        "taky_output": "config_error_message"
      }
    },
    {
      "input": "﻿[taky]\nhostname = bom\n",
      "keys": [
        "taky.hostname"
      ],
      "expect": {
        "error": "MissingSectionHeaderError",
        "taky_exit": 1,
        "taky_output": "config_error_message"
      }
    },
    {
      "input": "",
      "keys": [
        "taky.hostname",
        "cot_server.port",
        "taky.root_dir",
        "dp_server.upload_path"
      ],
      "expect": {
        "values": {
