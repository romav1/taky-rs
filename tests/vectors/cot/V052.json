{
  "id": "V052",
  "title": "cert-db re-read: a certificate issued after startup is invisible to kickban, and a later kickban drops its line",
  "runner": "cot",
  "tags": [
    "ssl",
    "mgmt",
    "ban",
    "bug"
  ],
  "source_refs": [
    "taky/taky/cot/server.py:84",
    "taky/taky/cot/mgmt.py:57",
    "taky/taky/util/anc.py:281"
  ],
  "notes": "D-11: Python's server.cert_db is read once at startup; `carol` (added to cert-db.txt while the server runs) is unknown, so kickban carol returns revoked_sns=[] and, when kickban alice rewrites the file from the stale in-memory db, carol's line is lost entirely. Rust re-reads cert-db.txt by mtime before each kickban: carol is revoked (revoked_sns=[carol]) and its line is preserved (read-modify-write under flock).",
  "now": "2030-01-01T00:00:00Z",
  "config": {
    "ssl": {
      "enabled": "true"
    },
    "cot_server": {
      "mon_ip": "127.0.0.1"
    }
  },
  "clients": {
    "A": {
      "kind": "cot",
      "cert": "alice"
    }
  },
  "steps": [
    {
      "op": "connect",
      "client": "A",
      "expect": {
        "deliveries": {}
      }
    },
    {
      "op": "issue_cert",
      "cn": "carol",
      "expect": {
        "deliveries": {}
      }
    },
    {
      "op": "mgmt",
      "request": {
        "cmd": "kickban",
        "user": "carol"
      },
      "rust_expect": {
        "deliveries": {},
        "mgmt_response": {
          "revoked_sns": [
            "$SERIAL_INT:carol"
          ]
        }
      },
      "expect": {
        "deliveries": {},
        "mgmt_response": {
          "revoked_sns": []
        }
      }
    },
    {
      "op": "mgmt",
      "request": {
        "cmd": "kickban",
        "user": "alice"
      },
      "expect": {
        "deliveries": {},
        "server_closed": [
          "A"
        ],
        "mgmt_response": {
          "revoked_sns": [
            "$SERIAL_INT:alice"
          ]
        }
      }
    }
  ],
  "final_expect_keys": [
    "cert_db_status"
  ],
  "expected-divergence": [
    "D-11"
  ],
  "final_rust_expect": {
    "cert_db_status": {
      "localhost": "V",
      "alice": "R",
      "carol": "R"
    }
  },
  "final_expect": {
    "cert_db_status": {
      "localhost": "V",
      "alice": "R"
    }
  },
